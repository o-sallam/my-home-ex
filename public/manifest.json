{
  "manifest_version": 3,
  "name": "Custom Home",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "description": "A quiet home for your favorite websites. Customizable shortcuts, entirely yours.",
  "permissions": [
    "storage",
    "offscreen",
    "bookmarks",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src 'self'; base-uri 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "limits-core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
